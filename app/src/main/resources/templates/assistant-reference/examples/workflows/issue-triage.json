{
  "name": "issue-triage",
  "description": "Triages a new issue and, when needed, asks the reporter for more information and waits up to 7 days for a reply on that issue; if none arrives, a person decides what to do.",
  "content": {
    "id": "issue-triage",
    "name": "issue-triage",
    "nodes": [
      {"id": "start", "type": "start", "name": "Start", "position": {"x": 0, "y": 0},
       "config": {"inputs": [
         {"name": "subject", "type": "object", "required": true, "description": "Subject created for the issue"},
         {"name": "event", "type": "object", "required": true, "description": "Triggering event"}
       ]}},
      {"id": "triage", "type": "action", "name": "Triage issue", "position": {"x": 200, "y": 0},
       "config": {"actionType": "triage-issue", "inputs": {"ref": "context.subject.ref", "repository": "context.subject.repository",
                                                         "priorityHint": "'normal'"},
                  "outputs": [{"name": "severity", "type": "string", "required": true},
                              {"name": "needsInfo", "type": "boolean", "required": true}]}},
      {"id": "ask", "type": "action", "name": "Request more info", "position": {"x": 400, "y": 0},
       "config": {"actionType": "request-more-info",
                  "inputs": {"ref": "context.subject.ref", "repository": "context.subject.repository"},
                  "outputs": [{"name": "commentUrl", "type": "string", "required": true}]}},
      {"id": "await-reply", "type": "receive-event", "name": "Await reply", "position": {"x": 600, "y": 0},
       "config": {"eventType": "issue.comment.created",
                  "correlationKey": {"subscriptionKey": "context.subject.ref", "eventKey": "event.ref"},
                  "match": ["event.payload.comment.url != context.commentUrl"],
                  "lookback": "run-start",
                  "timeout": "P7D"}},
      {"id": "no-reply", "type": "human-task", "name": "Decide on unanswered issue", "position": {"x": 800, "y": -200},
       "config": {"title": "'No reply on ' += context.subject.ref",
                  "description": "The reporter did not answer the request for more information within 7 days.",
                  "inputs": {"issue": "context.subject.ref", "severity": "context.severity"},
                  "outputs": [{"name": "closeIssue", "type": "boolean", "required": true,
                               "label": "Close the issue?"}]}},
      {"id": "end", "type": "end", "name": "End", "position": {"x": 800, "y": 200}, "config": {}}
    ],
    "edges": [
      {"id": "e1", "source": "start", "target": "triage", "priority": 0, "isDefault": false},
      {"id": "e2", "source": "triage", "target": "ask", "condition": "context.needsInfo == true",
       "priority": 1, "isDefault": false, "label": "needs info"},
      {"id": "e3", "source": "triage", "target": "end", "priority": 0, "isDefault": true, "label": "triaged"},
      {"id": "e4", "source": "ask", "target": "await-reply", "priority": 0, "isDefault": false},
      {"id": "e5", "source": "await-reply", "target": "end", "priority": 0, "isDefault": false, "label": "replied"},
      {"id": "e6", "source": "await-reply", "target": "no-reply", "priority": 1, "isDefault": false,
       "isTimeout": true, "label": "no reply in 7 days"},
      {"id": "e7", "source": "no-reply", "target": "end", "priority": 0, "isDefault": false}
    ]
  }
}
