{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A pull request was reopened.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "pullRequest"
  ],
  "properties": {
    "type": {
      "const": "pr.reopened",
      "description": "Payload type (same as the event type)."
    },
    "pullRequest": {
      "$ref": "#/$defs/NormalizedPullRequest",
      "description": "The pull request, as of this event."
    }
  }
}
