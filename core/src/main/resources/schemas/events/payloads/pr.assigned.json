{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A user was assigned to a pull request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "pullRequest"
  ],
  "properties": {
    "type": {
      "const": "pr.assigned",
      "description": "Payload type (same as the event type)."
    },
    "pullRequest": {
      "$ref": "#/$defs/NormalizedPullRequest",
      "description": "The pull request, as of this event."
    },
    "assignee": {
      "anyOf": [
        {
          "$ref": "#/$defs/Actor"
        },
        {
          "type": "null"
        }
      ],
      "description": "The assigned user."
    }
  }
}
