{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An issue was closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "issue"
  ],
  "properties": {
    "type": {
      "const": "issue.closed",
      "description": "Payload type (same as the event type)."
    },
    "issue": {
      "$ref": "#/$defs/NormalizedIssue",
      "description": "The issue, as of this event."
    }
  }
}
